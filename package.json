{
  "name": "mvp-website",
  "version": "1.0.0",
  "private": true,
  "nyc": {
    "reporter": [
      "lcov",
      "text",
      "json-summary"
    ],
    "report-dir": "coverage",
    "check-coverage": true,
    "branches": 70,
    "functions": 75,
    "lines": 80,
    "statements": 80
  },
  "coverageThreshold": {
    "branches": 70,
    "functions": 75,
    "lines": 80,
    "statements": 80
  },
  "description": "This repository contains the early MVP code for print2's website and backend.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "node scripts/run-jest.js --passWithNoTests",
    "test:image-pipeline": "node scripts/test-image-pipeline.js",
    "preinstall": "corepack enable && node scripts/check-node-version.js",
    "preformat": "true",
    "preformat:check": "true",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "lint": "npm run lint --prefix frontend && npm run lint --prefix backend",
    "typecheck": "tsc --noEmit",
    "validate-env": "bash scripts/validate-env.sh",
    "setup": "bash scripts/setup.sh",
    "prebuild": "node scripts/fetch-assets.cjs",
    "build": "npm ci --no-audit --no-fund --prefix frontend && npm --prefix frontend run build",
    "start:ci": "npm --prefix frontend run start:ci",
    "preview": "vite preview --port 4173",
    "prestart": "node scripts/fetch-assets.cjs",
    "start": "node scripts/dev-server.js",
    "start:backend": "npm start --prefix backend",
    "ci": "node scripts/ci.mjs",
    "backend:ci": "npm run --prefix backend ci",
    "smoke": "node scripts/smoke.mjs",
    "db:migrate": "npm run migrate --prefix backend",
    "db:check": "npm run db:check --prefix backend",
    "db:migrate:test": "npm run migrate --prefix backend",
    "prepare": "husky",
    "prepush": "echo \"(pre-push) no checks\""
  },
  "babel": {
    "presets": [
      "@babel/preset-env",
      "@babel/preset-react",
      "@babel/preset-typescript"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20.16 <21",
    "npm": ">=10"
  },
  "type": "commonjs",
  "packageManager": "npm@10.8.2",
  "prettier": {},
  "devDependencies": {
    "@actions/core": "^1.11.1",
    "@aws-sdk/client-cloudwatch": "^3.873.0",
    "@axe-core/cli": "^4.10.2",
    "@axe-core/playwright": "^4.10.2",
    "@babel/plugin-syntax-typescript": "^7.24.1",
    "@babel/plugin-transform-modules-commonjs": "^7.27.1",
    "@babel/plugin-transform-react-jsx": "^7.27.1",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@babel/register": "^7.27.1",
    "@commitlint/cli": "^19.2.1",
    "@commitlint/config-conventional": "^19.2.1",
    "@eslint-community/eslint-utils": "^4.7.0",
    "@eslint/js": "9.32.0",
    "@html-eslint/eslint-plugin": "0.46.1",
    "@html-eslint/parser": "^0.42.0",
    "@lhci/cli": "^0.15.0",
    "@octokit/action": "^8",
    "@percy/cli": "^1.31.0",
    "@percy/playwright": "^1.0.8",
    "@playwright/test": "^1.53.1",
    "@size-limit/file": "^11.2.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^14.2.1",
    "@types/jest": "29",
    "@types/node": "^24.0.10",
    "@typescript-eslint/eslint-plugin": "8.34.1",
    "@typescript-eslint/parser": "^8.36.0",
    "babel-preset-current-node-syntax": "^1.0.1",
    "concurrently": "9.2.0",
    "coveralls": "^3.1.1",
    "cross-env": "^7.0.3",
    "eslint": "9.32.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-jsdoc": "51.1.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-no-inline-styles": "1.0.5",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-promise": "7.2.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-ssr-friendly": "^1.3.0",
    "execa": "^9.6.0",
    "express": "^4.21.2",
    "gltf-validator": "^2.0.0-dev.3.10",
    "http-server": "^14.1.1",
    "husky": "9.1.7",
    "i18next-parser": "^9.3.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "^30.0.5",
    "jest-image-snapshot": "^6.5.1",
    "jest-junit": "^16.0.0",
    "kill-port": "^2.0.1",
    "lint-staged": "^16.1.2",
    "lockfile-diff": "^0.1.0",
    "markdownlint-cli2": "^0.10.0",
    "nock": "^13.5.6",
    "playwright": "^1.54.1",
    "prettier": "^3.5.3",
    "selfsigned": "^2.3.2",
    "size-limit": "^11.2.0",
    "source-map": "^0.7.4",
    "source-map-support": "^0.5.21",
    "stripe": "^14.25.0",
    "supertest": "^7.1.4",
    "toml": "^3.0.0",
    "ts-jest": "29.2.5",
    "tsconfig-strictest": "^1.0.0-beta.1",
    "tslib": "^2.8.1",
    "tsx": "^4.20.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.3",
    "yaml": "^2.8.0"
  },
  "_comment_concurrently": "align with lockfile to satisfy npm ci; bump later with a dedicated PR",
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --log-level warn --write"
    ],
    "*.ts": [
      "eslint --fix",
      "prettier --log-level warn --write"
    ]
  },
  "dependencies": {
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.2.0",
    "react-places-autocomplete": "^7.3.0",
    "three": "^0.180.0",
    "vite": "^5.4.3",
    "winston": "^3.17.0",
    "winston-format": "^1.0.1"
  }
}
