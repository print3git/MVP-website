{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noEmit": true,
    "lib": ["ESNext", "DOM"],
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "backend/utils/generateTitle.js",
    "backend/**/*.{ts,tsx}",
    "tests/**/*.{ts,tsx}"
  ],
  "exclude": ["node_modules", "img", "models", "uploads"]
}
