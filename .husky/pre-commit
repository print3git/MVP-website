#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# If package.json is staged, refresh package-lock.json deterministically
if git diff --cached --name-only | grep -q '^package.json$'; then
  echo "[husky] package.json changed — refreshing package-lock.json"
  npm install --package-lock-only
  git add package-lock.json
fi
