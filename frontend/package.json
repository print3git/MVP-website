{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20.x",
    "npm": "10"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "test": "node ../scripts/ensure-tests-exist.js && npx jest --passWithNoTests=false",
