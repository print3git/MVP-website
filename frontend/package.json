  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@vitejs/plugin-react": "^5.0.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.4"
  }
}
