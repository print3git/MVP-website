    "target": "ES2022",
    "module": "CommonJS",
    "esModuleInterop": true,
    "types": ["node"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "noEmitOnError": false,
    "moduleResolution": "node"
