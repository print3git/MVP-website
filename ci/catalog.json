{
  "suites": [
    {
      "id": "frontend:lint",
      "type": "lint",
      "paths": ["frontend/**"],
      "junit": "frontend/reports/junit.xml"
    },
    {
      "id": "frontend:test",
      "type": "unit",
      "paths": ["frontend/**"],
      "junit": "frontend/reports/junit.xml"
    },
    {
      "id": "backend:test",
      "type": "unit",
      "paths": ["backend/**"],
      "junit": "backend/junit.xml"
    },
    { "id": "types:check", "type": "types" },
    { "id": "codeql:analyze", "type": "sast" }
  ]
}
