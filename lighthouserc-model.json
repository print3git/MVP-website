{
  "ci": {
    "collect": {
      "startServerCommand": "npx http-server -c-1 -p 3000",
      "url": [
        "http://localhost:3000/index.html",
        "http://localhost:3000/payment.html"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
